# History files
.Rhistory
.Rapp.history

# Session Data files
.RData

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
/*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# Shiny token, see https://shiny.rstudio.com/articles/shinyapps.html
rsconnect/

# Claude Code internal directory (Claude Code内部目录)
.claude/

# ── EasyMetagenome: large data and intermediate files ──────────────────────────

# Raw and cleaned sequencing data (测序原始数据)
seq/*.fq.gz
seq/*.fastq.gz

# Intermediate analysis files (中间分析文件)
temp/

# Large binary/annotation databases (大型数据库文件)
*.bam
*.sam
*.bai

# Log files (日志文件)
*.log

# Legacy test result directory (遗留测试结果目录)
result12/

# Config overrides (本地配置覆盖)
config.local.sh
